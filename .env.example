# Phase 4: Sepolia; execution OFF by default. Never put secrets in git.
TELEGRAM_BOT_TOKEN=
SERA_NETWORK=sepolia
ENABLE_MAINNET=false
ENABLE_TESTNET_EXECUTION=false
# dev:live always forces execution OFF at runtime. Later execution requires the owner acceptance gate.
# Empty allowlist denies all execution; use only the owner's numeric Telegram ID.
EXECUTION_USER_IDS=
# These are optional for read-only bot commands; required for wallet screens.
SEPOLIA_RPC_URL=
SIGNING_ORIGIN=
# dev:live supplies the current temporary origin automatically; no manual tunnel URL is needed here.
WALLETCONNECT_PROJECT_ID=
# Optional owner-supplied attribution link. Reserved for documentation/footer use;
# no automatic referral UI or transaction attribution is implemented.
SERA_REFERRAL_URL=
# Paste only your own dedicated development Reown Project ID here once (32 hexadecimal characters).
# dev:live watches this field and checks/builds/reloads automatically after saving.
# Optional existing cloudflared executable; normally auto-detected/downloaded on Windows:
# CLOUDFLARED_PATH=
SIGNING_PORT=8787
WALLET_SESSION_SECONDS=900
SETTLEMENT_POLL_SECONDS=60
# Input units are test USDC, not a universal USD limit. May lower, never above 100.
TEST_USDC_MAX_AMOUNT=100
DATABASE_PATH=./data/bot.sqlite
SERA_REQUEST_INTERVAL_MS=500
SERA_TIMEOUT_MS=15000
SERA_RETRIES=2
SERA_MAX_RETRY_WAIT_MS=2000
SERA_RATE_CACHE_MS=10000
SERA_REFERENCE_MAX_AGE_SECONDS=900
LIQUIDITY_PROBE_SIZES=100,1000,10000
CONVERSATION_TTL_SECONDS=900
# Delay after each monitoring cycle (minimum 60 seconds).
MARKET_POLL_INTERVAL_SECONDS=60
ALERT_COOLDOWN_SECONDS=3600
ALERT_MAX_GROUPS_PER_CYCLE=10
ALERT_MAX_PER_USER=20
ALERT_MAX_TOTAL=500
ALERT_BASELINE_TOLERANCE_SECONDS=300
ALERT_OBSERVATION_RETENTION_HOURS=72
ALERT_NOTIFICATION_TTL_SECONDS=900
# Public scanner sample set, source-token units; at most 12 pair:amount entries.
# Shares the existing monitor's interval and per-cycle budget.
ALPHA_ENABLED=true
ALPHA_PROBES=USDC/XSGD:100,USDC/EURC:100,XIDR/USDT:1000000
ALPHA_MAX_RESULTS=12
ALPHA_DATA_MAX_AGE_SECONDS=180
ALPHA_MOVEMENT_1H_PCT=0.5
ALPHA_MOVEMENT_6H_PCT=1
ALPHA_MOVEMENT_24H_PCT=2
ALPHA_RECOVERY_MAX_AGE_SECONDS=900
# Growth reports are local SQLite aggregates; no external analytics credentials.
# If unset, both lists fall back to the local EXECUTION_USER_IDS owner allowlist.
# Dedicated comma-separated numeric IDs; explicitly empty disables that list.
# ANALYTICS_ADMIN_USER_IDS=123456789
# ANALYTICS_EXCLUDED_USER_IDS=123456789
